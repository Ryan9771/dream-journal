# Copy to .env.local. These identify the Firebase pre-production web app.
# Firebase web configuration is public client configuration, not a secret.
REACT_APP_FIREBASE_API_KEY=replace-me
REACT_APP_FIREBASE_AUTH_DOMAIN=your-recall-preprod-project-id.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your-recall-preprod-project-id
# Leave empty locally and in the combined Cloud Run build. The React dev
# server proxies /api to Flask on port 5001.
REACT_APP_API_URL=
